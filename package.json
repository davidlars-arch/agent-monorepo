{
  "name": "project-sphere",
  "private": true,
  "version": "0.1.0",
  "description": "OpenClaw project atlas with a 3D repo globe, Unity RPG slice, analytics POC, and repo health loop.",
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @agent/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "loop:projects": "node scripts/project-loop.mjs",
    "planner:agent-runner": "node scripts/planner-agent-runner.mjs",
    "test:atlas-loop-runner": "node --test scripts/atlas-loop-runner-actions.test.mjs",
    "test:atlas-runner-wrappers": "node --test scripts/atlas-runner-wrapper.test.mjs",
    "test:loop-controller": "node --test scripts/project-loop.test.mjs",
    "test:planner-agent-runner": "node --test scripts/planner-agent-runner.test.mjs",
    "loop:repo-health": "node scripts/repo-health-loop.mjs",
    "usage:status": "node scripts/usage-status.mjs",
    "loop:web-atlas": "node scripts/web-atlas-loop.mjs",
    "sync:unity-webgl": "node scripts/sync-unity-webgl.mjs",
    "dbt:debug": "dbt debug --project-dir analytics/dbt-agent-poc --profiles-dir analytics/dbt-agent-poc"
  },
  "engines": {
    "node": ">=22"
  }
}
